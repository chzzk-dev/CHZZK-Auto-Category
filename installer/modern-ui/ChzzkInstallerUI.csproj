<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ChzzkInstallerUI</AssemblyName>
    <RootNamespace>Chzzk.Installer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EmbeddedInstallerUI.cs" />
    <Compile Include="InstallState.cs" />
    <Compile Include="SetupWindow.cs" />
    <Compile Include="InstallerDiagnostics.cs" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="5.0.2" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" PrivateAssets="all" Condition="'$(OS)' == 'Windows_NT'" />
    <EmbeddedResource Include="SetupWindow.xaml" LogicalName="Chzzk.Installer.SetupWindow.xaml" />
    <EmbeddedResource Include="../../chzzk_auto_category.ico" LogicalName="Chzzk.Installer.AppIcon.ico" />
    <Content Include="EmbeddedUI.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
