<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHZZK Auto Category 설치" Width="1200" Height="820" MinWidth="1200" MinHeight="820"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Malgun Gothic" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#132C37" />
    <SolidColorBrush x:Key="Muted" Color="#607782" />
    <SolidColorBrush x:Key="Accent" Color="#49EDBB" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button" x:Key="SoftButton">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#27434E" />
      <Setter Property="BorderBrush" Value="#DCE6E9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#735DDC" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource SoftButton}">
      <Setter Property="Background" Value="#49EDBB" /><Setter Property="BorderBrush" Value="#49EDBB" />
      <Setter Property="Foreground" Value="#10392E" /><Setter Property="MinWidth" Value="180" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F5F9FA" /><Setter Property="Foreground" Value="#27434E" />
      <Setter Property="BorderBrush" Value="#DCE6E9" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,12" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#1B9B78" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#344D59" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="CheckSurface" Width="22" Height="22" Background="#F1F6F5" BorderBrush="#C4D9D2" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
            <TextBlock x:Name="CheckMark" Text="✓" Foreground="#0B694C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Border>
          <ContentPresenter VerticalAlignment="Center" />
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#ACF5D9" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#735DDC" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="12" Background="#F6FAFB" BorderBrush="#D3E5E4" BorderThickness="1" CornerRadius="26">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.14" /></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="324" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="25,0,0,25">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D3339" /><GradientStop Color="#103F40" Offset="0.6" /><GradientStop Color="#17323E" Offset="1" /></LinearGradientBrush></Border.Background>
        <Grid ClipToBounds="True">
          <Canvas IsHitTestVisible="False" Opacity="0.35">
            <Ellipse Width="350" Height="350" Stroke="#45B995" StrokeThickness="1" Canvas.Left="68" Canvas.Top="335" />
            <Ellipse Width="260" Height="260" Stroke="#45B995" StrokeThickness="1" Canvas.Left="113" Canvas.Top="380" />
            <Ellipse Width="170" Height="170" Stroke="#45B995" StrokeThickness="1" Canvas.Left="158" Canvas.Top="425" />
            <Ellipse Width="10" Height="10" Fill="#80FFDA" Canvas.Left="197" Canvas.Top="399" />
            <Ellipse Width="7" Height="7" Fill="#BBA7FF" Canvas.Left="304" Canvas.Top="621" />
          </Canvas>
          <Grid Margin="30,36,30,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="46" Height="46" Background="#214F50" CornerRadius="14" BorderBrush="#3B6B62" BorderThickness="1"><Image x:Name="BrandIcon" Margin="7" /></Border>
              <StackPanel Margin="12,3,0,0"><TextBlock Text="CHZZK" Foreground="White" FontWeight="Bold" FontSize="20" /><TextBlock Text="AUTO CATEGORY" Foreground="#A4D8CE" FontSize="10" Margin="0,3,0,0" /></StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,46,0,0">
              <TextBlock Text="방송에 집중하세요." FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
              <TextBlock Text="카테고리는 자동으로." FontSize="24" FontWeight="Bold" Foreground="#78F3CC" Margin="0,8,0,0" />
              <TextBlock Text="게임 감지부터 카테고리 변경까지,&#10;방송의 흐름을 자연스럽게 연결합니다." FontSize="13" Foreground="#B4D2D0" Margin="0,20,0,0" LineHeight="23" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,44,0,0">
              <StackPanel Orientation="Horizontal"><Border x:Name="StepOneCircle" Background="#49EDBB" Width="32" Height="32" CornerRadius="10"><TextBlock Text="01" Foreground="#0D3930" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="설치 준비" Foreground="White" FontWeight="Bold" /><TextBlock Text="설치 위치와 실행 옵션" Foreground="#A6C9C6" FontSize="11" Margin="0,4,0,0" /></StackPanel></StackPanel>
              <Border Height="22" Width="1" Background="#476E69" HorizontalAlignment="Left" Margin="16,7,0,7" />
              <StackPanel Orientation="Horizontal"><Border x:Name="StepTwoCircle" Background="#244D50" Width="32" Height="32" CornerRadius="10"><TextBlock Text="02" Foreground="#D0EBE5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="설치 진행" Foreground="White" FontWeight="Bold" /><TextBlock Text="프로그램을 준비하는 중" Foreground="#A6C9C6" FontSize="11" Margin="0,4,0,0" /></StackPanel></StackPanel>
              <Border Height="22" Width="1" Background="#476E69" HorizontalAlignment="Left" Margin="16,7,0,7" />
              <StackPanel Orientation="Horizontal"><Border x:Name="StepThreeCircle" Background="#244D50" Width="32" Height="32" CornerRadius="10"><TextBlock Text="03" Foreground="#D0EBE5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="시작하기" Foreground="White" FontWeight="Bold" /><TextBlock Text="첫 실행 설정으로 연결" Foreground="#A6C9C6" FontSize="11" Margin="0,4,0,0" /></StackPanel></StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="4"><TextBlock Text="DESIGNED FOR YOUR STREAM" Foreground="#8DBAB6" FontSize="9" /><TextBlock x:Name="SideVersion" Text="Windows · MSI" Foreground="#C7E2DC" FontSize="11" Margin="0,8,0,0" /></StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="38,24,32,28">
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent">
          <TextBlock Text="CHZZK Auto Category" Foreground="#677F88" FontSize="12" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MinimizeButton" Content="−" Style="{StaticResource SoftButton}" Padding="0" Width="36" MinHeight="32" Margin="0,0,8,0" BorderThickness="0" Background="Transparent" ToolTip="최소화" />
            <Button x:Name="CloseButton" Content="×" Style="{StaticResource SoftButton}" Padding="0" Width="36" MinHeight="32" BorderThickness="0" Background="Transparent" ToolTip="닫기" />
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,28,0,26">
          <StackPanel Orientation="Horizontal"><Border Background="#E3F5EF" CornerRadius="7" Padding="10,5"><TextBlock Text="STREAM AUTOMATION" Foreground="#187755" FontSize="10" FontWeight="Bold" /></Border><Border Background="#ECE8FA" CornerRadius="7" Padding="10,5" Margin="8,0,0,0"><TextBlock x:Name="VersionBadge" Text="v4.11.3" Foreground="#7252B6" FontSize="10" FontWeight="Bold" /></Border></StackPanel>
          <TextBlock x:Name="PageTitle" Text="새로운 방송 흐름의 시작" FontSize="30" FontWeight="Bold" Margin="0,17,0,0" />
          <TextBlock x:Name="PageDescription" Text="몇 가지 선택만으로 설치를 마칠 수 있습니다." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <Grid>
            <StackPanel x:Name="OptionsPanel">
              <Border Background="#FFFFFF" CornerRadius="20" BorderBrush="#E0E9ED" BorderThickness="1" Padding="24">
                <StackPanel>
                  <TextBlock Text="설치 위치" FontWeight="Bold" FontSize="17" />
                  <TextBlock x:Name="FolderDescription" Text="프로그램을 설치할 폴더를 선택해 주세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,16" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallFolder" Text="C:\Program Files\CHZZK Auto Category" AutomationProperties.Name="설치 위치" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="변경" Style="{StaticResource SoftButton}" Margin="10,0,0,0" />
                  </Grid>
                  <TextBlock x:Name="FolderError" Foreground="#B63E5C" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />
                  <Border Height="1" Background="#EAF0F2" Margin="0,22,0,12" />
                  <CheckBox x:Name="LaunchCheckBox" IsChecked="True" Content="완료 후 프로그램 실행" />
                  <TextBlock x:Name="LaunchHint" Text="처음 실행하면 채널과 확장프로그램 연결을 안내합니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="32,9,0,0" />
                </StackPanel>
              </Border>
              <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="#EDF8F3" BorderBrush="#D8ECE1" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,7,0"><StackPanel><TextBlock Text="자동으로, 가볍게" FontWeight="Bold" /><TextBlock Text="게임 감지와 카테고리 변경을&#10;백그라운드에서 연결합니다." Foreground="#59776D" FontSize="11" Margin="0,9,0,0" LineHeight="19" /></StackPanel></Border>
                <Border Grid.Column="1" Background="#F0EDF9" BorderBrush="#E1DAF1" BorderThickness="1" CornerRadius="16" Padding="18" Margin="7,0,0,0"><StackPanel><TextBlock Text="설정은 그대로" FontWeight="Bold" Foreground="#51416E" /><TextBlock Text="업데이트와 프로그램 제거 시&#10;저장한 사용자 설정을 유지합니다." Foreground="#75698D" FontSize="11" Margin="0,9,0,0" LineHeight="19" /></StackPanel></Border>
              </Grid>
              <StackPanel x:Name="MaintenancePanel" Orientation="Horizontal" Margin="0,18,0,0" Visibility="Collapsed">
                <Button x:Name="RepairButton" Content="프로그램 복구" Style="{StaticResource SoftButton}" Margin="0,0,10,0" />
                <Button x:Name="RemoveButton" Content="프로그램 제거" Style="{StaticResource SoftButton}" Foreground="#AB3655" BorderBrush="#E9CBD4" />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
              <Border Background="#FFFFFF" CornerRadius="20" BorderBrush="#E0E9ED" BorderThickness="1" Padding="28">
                <StackPanel>
                  <Grid><TextBlock x:Name="ProgressTitle" Text="프로그램을 설치하고 있습니다" FontSize="18" FontWeight="Bold" /><TextBlock x:Name="PercentLabel" Text="0%" HorizontalAlignment="Right" Foreground="#178262" FontSize="18" FontWeight="Bold" /></Grid>
                  <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Height="10" Margin="0,28,0,0" Foreground="#32DCA5" Background="#E9F1EF" BorderThickness="0" />
                  <TextBlock x:Name="CurrentAction" Text="설치를 준비하고 있습니다." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,20,0,0" />
                  <Border Background="#F4F8F9" CornerRadius="12" Padding="16" Margin="0,28,0,0"><StackPanel><TextBlock Text="설치 위치" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="ProgressFolder" FontSize="12" Margin="0,7,0,0" /></StackPanel></Border>
                </StackPanel>
              </Border>
              <TextBlock Text="Windows 권한 확인 창이 나타나면 설치를 허용해 주세요." Foreground="{StaticResource Muted}" Margin="4,18,0,0" FontSize="12" />
            </StackPanel>
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
              <Border Background="#FFFFFF" CornerRadius="20" BorderBrush="#E0E9ED" BorderThickness="1" Padding="30">
                <StackPanel>
                  <Border x:Name="ResultGlyphBackground" Width="60" Height="60" HorizontalAlignment="Left" CornerRadius="20" Background="#DCF8EA"><TextBlock x:Name="ResultGlyph" Text="✓" FontSize="30" FontWeight="Bold" Foreground="#12845A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock x:Name="ResultTitle" Text="설치가 완료되었습니다" FontSize="23" FontWeight="Bold" Margin="0,22,0,0" />
                  <TextBlock x:Name="ResultDescription" Foreground="{StaticResource Muted}" LineHeight="24" Margin="0,14,0,0" />
                  <Border Background="#F4F8F9" CornerRadius="12" Padding="16" Margin="0,22,0,0"><TextBlock x:Name="ResultDetail" FontSize="12" Foreground="{StaticResource Muted}" /></Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,24,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Height="1" Background="#DDE8EB" Margin="0,0,0,18" />
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterNote" Text="설치 후 첫 실행에서 설정을 안내합니다." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CancelButton" Content="취소" Style="{StaticResource SoftButton}" Margin="0,0,10,0" />
              <Button x:Name="PrimaryButton" Content="설치 시작  →" Style="{StaticResource PrimaryButton}" IsDefault="True" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
