{
  "manifest_version": 3,
  "name": "CHZZK : 자동 카테고리 연결 커넥터",
  "version": "0.5.3",
  "description": "CHZZK Auto Category 앱과 치지직 스튜디오의 게임 카테고리 변경을 자동으로 연결해주는 커넥터입니다.",
  "permissions": [
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://studio.chzzk.naver.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CHZZK : 자동 카테고리 연결 커넥터"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
